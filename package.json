{
  "name": "every-other-skill",
  "version": "0.1.0",
  "private": true,
  "description": "One curated OtherSkill skill bank for product discovery, frontend design, architecture, tech stack, web and mobile, plus a sandbox to A/B test skill sets",
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "list": "bun scripts/list.ts",
    "install:global": "bun scripts/install-global.ts",
    "install:project": "bun scripts/install-project.ts",
    "sandbox": "bun sandbox/run.ts",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome format . && biome lint . && tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
