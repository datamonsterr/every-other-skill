{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "every-other-skill skill set manifest",
  "type": "object",
  "required": ["version", "self", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "self": {
      "type": "string",
      "description": "GitHub tree URL of this repo; provenance base for local skills"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "skills"],
        "properties": {
          "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "ref": {
            "type": "string",
            "description": "Branch or tag; default branch when omitted"
          },
          "local": {
            "type": "boolean",
            "description": "Skill paths are inside this repo"
          },
          "label": { "type": "string" },
          "licenseFile": {
            "type": "string",
            "description": "License inside the repo when it is not at the root"
          },
          "license": {
            "type": "string",
            "description": "SPDX id declared upstream when no license file ships"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "categories"],
              "properties": {
                "path": { "type": "string" },
                "categories": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
